# Server
PORT=3000
NODE_ENV=development
DATABASE_PATH=data/navigator-dev.db
# Required in production (public base URL, e.g. https://navigator.example.com)
APP_URL=
# Required in production (>= 24 chars). Shared secret for the billing webhook HMAC signature.
BILLING_WEBHOOK_SECRET=
# Behind a reverse proxy, set to true so rate limiting uses the real client IP.
TRUST_PROXY=false

# Development conveniences (default: on in development, off in production)
SEED_DEMO=true
ALLOW_PUBLIC_DEMO=true
# Legacy research lab (Gemini). Must be unset/false in production.
ENABLE_LAB=true
GEMINI_API_KEY=
